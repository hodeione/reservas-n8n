{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && VITE_DEMO=1 npm run build",
  "outputDirectory": "web/dist",
  "framework": null,
  "rewrites": [{ "source": "/((?!assets/|platos/|modelos/|miniaturas/|fotos/|flujos/|vendor/|favicon).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(platos|modelos|miniaturas|fotos|flujos|vendor|assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ]
}
