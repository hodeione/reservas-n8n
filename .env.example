# ---------- Servidor ----------
URL_PUBLICA=http://localhost:5680
DOMINIO=localhost
PUERTO_LOCAL=5680
N8N_SECURE_COOKIE=false            # true en producción (HTTPS)
POSTGRES_PASSWORD=cambia-esto
N8N_ENCRYPTION_KEY=cambia-esto-por-32-caracteres-aleatorios

# ---------- Cuenta de administrador de n8n (la crea el script de instalación) ----------
N8N_ADMIN_EMAIL=admin@restaurante.es
N8N_ADMIN_PASSWORD=Cambia-esto-123

# ---------- Correo (en desarrollo, Mailpit; en producción, tu SMTP: Gmail, Brevo, Resend…) ----------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------- Restaurante ----------
REST_NOMBRE=Taberna Luna
REST_EMAIL_DUENO=dueno@restaurante.es
REST_EMAIL_REMITENTE=reservas@restaurante.es
REST_TELEFONO=944 12 34 56
REST_DIRECCION=Calle Somera 12, Bilbao
REST_AFORO_COMIDA=40               # comensales por franja de 30 min
REST_AFORO_CENA=40
REST_ENTRADAS_FRANJA=16           # comensales que pueden llegar a la vez en cada franja (ritmo de cocina)
REST_ANTELACION_MIN=60             # minutos mínimos de antelación para reservar online
REST_DIAS_MAX=60                   # hasta cuántos días vista se puede reservar
REST_HORAS_COMIDA=13:00,13:30,14:00,14:30,15:00
REST_HORAS_CENA=20:00,20:30,21:00,21:30,22:00
REST_DIAS_CERRADO=1                # 1=lunes … 7=domingo, separados por comas
REST_MAX_PERSONAS=10               # grupos mayores: por teléfono
REST_URL_RESENA=https://g.page/r/TU-ENLACE/review
REST_CLAVE_PANEL=cambia-esta-clave
REST_CLAVE_AGENTE=cambia-esta-clave-del-agente-de-voz   # para el recepcionista de IA por teléfono
